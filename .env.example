# CORS 允许的源，多个源用逗号分隔
# 示例: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:6200
ALLOWED_ORIGINS=*

# 是否启用数据库
USE_DATABASE=false

# 自动存储 URL接口返回值 到数据库
AUTO_STORE_URL=false

# 首页重定向地址
HOME_REDIRECT_URL=https://domdkw.github.io/miguMusic-api-enhanced/

# API 鉴权密钥；设置后调用接口需带 Authorization: Bearer <key> 或 ?key=<key>
# 不设置则不鉴权；/migu、/migu/status、/migu/version 始终公开
# API_KEY=

# pacmtoken 会话保活：EdgeOne 控制台新建 KV 命名空间并绑定到边缘函数，
# 变量名填 MIGU_KV（KV 以裸全局标识符注入，不是环境变量，这里不用填）。
# 绑好后登录一次，登录态就存在 KV 里，服务端自动续期；定时任务每 6 小时
# 验一次（见 .github/workflows/refresh-pacmtoken.yml，需配 MIGU_API_KEY）。
# 不自动重新登录，ST 死了需手动重新登录一次。
